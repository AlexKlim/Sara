    "You" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты"
          }
        }
      }
    },
    "Your devices with the same Apple ID get the keys and the address through iCloud by themselves. For someone with their own Apple ID: show the code here, and on their device tap Scan connection." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои устройства с тем же Apple ID получат ключи и адрес через iCloud сами. Для человека со своим Apple ID: покажи код здесь, а на его устройстве нажми «Сканировать подключение»."
          }
        }
      }
    },
    "Schedule" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расписание"
          }
        }
      }
    },
    "The thermostat has not sent its schedule yet. It usually arrives within 5 minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термостат ещё не прислал расписание. Обычно оно приходит в течение 5 минут."
          }
        }
      }
    },
    "To change it, ask Sara." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
